# Виртуальное окружение — у каждого своё, в репозиторий не кладут
.venv/
venv/

# Секреты и локальные настройки не публикуют
.env

# Пакеты Node.js
node_modules/

# Кэш Python и pytest
__pycache__/
.pytest_cache/

# Результаты и отчёты Allure генерируются при запуске
allure-results/
allure-report/

# Настройки PyCharm личные для каждого компьютера
.idea/
